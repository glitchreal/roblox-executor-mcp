{
  "name": "roblox-mcp-server",
  "version": "1.0.0",
  "description": "An MCP server for interacting with Roblox Game Clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "roblox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/update.mjs",
    "connector.luau",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build:connector": "darklua process connector-src/init.luau connector.luau",
    "build": "node scripts/build-server.mjs",
    "build:all": "npm run build:connector && npm run build",
    "test": "npm run build:all && node --test tests/*.test.mjs && luau tests/connector-modules.test.luau",
    "dev": "node scripts/dev-server.mjs",
    "dev:dist": "bun run build && bun scripts/dev-server.mjs --dist",
    "install:tailscale": "bun scripts/install-tailscale.mjs",
    "install:harness": "node scripts/install-harnesses-web.mjs",
    "install:harnesses": "node scripts/install-harnesses-web.mjs",
    "install:harnesses:cli": "node scripts/run-with-bun.mjs scripts/install-harnesses.mjs",
    "install:harnesses:web": "node scripts/install-harnesses-web.mjs",
    "install:harnesses:preview": "node scripts/install-harnesses-web.mjs --preview",
    "benchmark:roblox-mcp": "npm run build && node benchmarks/roblox-mcp/src/run.mjs",
    "benchmark:roblox-mcp:check": "npm run build && node benchmarks/roblox-mcp/src/run.mjs --dry-run",
    "benchmark:roblox-mcp:import": "node benchmarks/roblox-mcp/src/import-capture.mjs",
    "getscript": "bun scripts/install-harnesses.mjs --get-script",
    "start": "node dist/index.js",
    "start:core": "node dist/core.js",
    "update": "node scripts/update.mjs",
    "prepare": "bun run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/upio/roblox-executor-mcp.git"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@opentui/core": "^0.4.1",
    "ws": "^8.18.3",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
